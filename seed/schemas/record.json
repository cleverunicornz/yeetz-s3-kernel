{
  "$comment": "Installed by bedrock v0.6.0 — DO NOT EDIT. This file is owned by the tool. Base changes: file an issue or PR at https://github.com/cleverunicornz/bedrock. Local refresh: bedrock update.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeetz.dev/bedrock/schema/record/v4",
  "title": "Bedrock record namespace vertex schema",
  "description": "Epoch records, deploy placements, reflect verdicts, and decisions (0.3.0 base protocol). DeployRecord is digest-pinned — it records what was actually placed, never a 'latest' pointer. ReflectVerdict carries subject, criteria, witnesses, findings (optional suspect: code|promise|instrument), disposition+residual. Decision is a named collapse of the possibility space: write-once, immutable at birth, no status field — liveness is derived from the supersedes chain. Validates every situation/record/*.yamlld vertex.",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@id", "@type"],
  "properties": {
    "@context": { "const": "https://yeetz.dev/bedrock/context/v1" },
    "@id": { "$ref": "#/$defs/vertexId" },
    "@type": { "$ref": "#/$defs/type" },
    "label": { "$ref": "#/$defs/label" },
    "statement": { "$ref": "#/$defs/boundedText" },
    "commit": { "$ref": "#/$defs/gitCommit" },
    "version": { "$ref": "#/$defs/version" },
    "offline": { "type": "boolean", "$comment": "true stamps that --offline was used (SPINE §1 / §6 version gate)" },
    "mode": { "enum": ["init", "adopt"] },
    "artifactDigest": { "$ref": "#/$defs/artifactDigest", "$comment": "sha256 of the placed artifact — digest-pinned, never 'latest'" },
    "destination": { "$ref": "#/$defs/boundedText", "$comment": "where the artifact was placed" },
    "config": { "$ref": "#/$defs/pointer", "$comment": "reference to the config that produced the artifact" },
    "result": { "$ref": "#/$defs/boundedText", "$comment": "what the placement returned" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },
    "subject": { "$ref": "#/$defs/vertexPointer", "$comment": "ReflectVerdict: the vertex being judged" },
    "criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/boundedText" }, "$comment": "ReflectVerdict: the criteria the subject was judged against" },
    "witnesses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/witness" }, "$comment": "CI-run-URL class; rule C8: disposition done with zero witnesses is a violation" },
    "findings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/finding" } },
    "disposition": {
      "type": "object",
      "properties": {
        "state": { "enum": ["draft", "active", "done", "abandoned"] },
        "residual": { "$ref": "#/$defs/boundedText" }
      },
      "required": ["state"],
      "additionalProperties": false
    },
    "requires": { "$ref": "#/$defs/vertexPointer" },
    "references": { "$ref": "#/$defs/vertexPointerList" },
    "consumes": { "$ref": "#/$defs/pointerList" },
    "produces": { "$ref": "#/$defs/pathPointerList" },
    "member-of": { "$ref": "#/$defs/vertexPointer" },
    "supersedes": { "$ref": "#/$defs/vertexPointer", "$comment": "this record replaces an earlier vertex, which stays untouched (append-only — floor invariant 15)" },
    "source": { "$ref": "#/$defs/pathPointer" },
    "path": { "$ref": "#/$defs/pathPointerList" },
    "body": { "$ref": "#/$defs/body" }
  },
  "minProperties": 3,
  "allOf": [
    {
      "if": { "anyOf": [
        { "properties": { "@type": { "const": "https://yeetz.dev/bedrock/ontology/EpochRecord" } } },
        { "properties": { "@type": { "type": "array", "contains": { "const": "https://yeetz.dev/bedrock/ontology/EpochRecord" } } } }
      ], "required": ["@type"] },
      "then": { "required": ["commit", "version", "mode", "statement"] }
    },
    {
      "if": { "anyOf": [
        { "properties": { "@type": { "const": "https://yeetz.dev/bedrock/ontology/DeployRecord" } } },
        { "properties": { "@type": { "type": "array", "contains": { "const": "https://yeetz.dev/bedrock/ontology/DeployRecord" } } } }
      ], "required": ["@type"] },
      "then": { "required": ["artifactDigest", "destination", "config", "result", "timestamp"] }
    },
    {
      "if": { "anyOf": [
        { "properties": { "@type": { "const": "https://yeetz.dev/bedrock/ontology/ReflectVerdict" } } },
        { "properties": { "@type": { "type": "array", "contains": { "const": "https://yeetz.dev/bedrock/ontology/ReflectVerdict" } } } }
      ], "required": ["@type"] },
      "then": { "required": ["subject", "criteria"] }
    },
    {
      "if": { "anyOf": [
        { "properties": { "@type": { "const": "https://yeetz.dev/bedrock/ontology/Decision" } } },
        { "properties": { "@type": { "type": "array", "contains": { "const": "https://yeetz.dev/bedrock/ontology/Decision" } } } }
      ], "required": ["@type"] },
      "then": {
        "required": ["statement", "timestamp"],
        "not": { "anyOf": [ { "required": ["disposition"] }, { "required": ["witnesses"] } ] }
      },
      "$comment": "Decision: the named collapse — statement carries the choice, the rejected alternatives, and the revisit conditions; timestamp orders the log. disposition and witnesses are rejected here: a decision is not CI-judged."
    }
  ],
  "anyOf": [{ "required": ["label"] }, { "required": ["statement"] }],
  "$defs": {
    "vertexId": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/vertex/[a-z0-9][a-z0-9-]*$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "body": { "type": "string", "minLength": 1, "$comment": "Unbounded node-local depth; always cold. Decisions project their compact face; episodic record types remain cold." },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "witness": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^https://[^\\s]+$", "$comment": "CI-run-URL class, never a local attestation" },
    "finding": {
      "type": "object",
      "properties": {
        "statement": { "$ref": "#/$defs/boundedText" },
        "suspect": { "enum": ["code", "promise", "instrument"] }
      },
      "required": ["statement"],
      "additionalProperties": false
    },
    "pathPointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/path/[A-Za-z0-9._/\\-]+$" },
    "vertexPointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/vertex/[a-z0-9][a-z0-9-]*$" },
    "vertexPointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/vertexPointer" } },
    "pointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/(vertex|path)/[A-Za-z0-9._/\\-]+$" },
    "pointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pointer" } },
    "pathPointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pathPointer" } },
    "type": {
      "description": "one base type scalar, or an array with at least one base type (repo archetypes ride alongside; rule C9)",
      "oneOf": [
        { "type": "string", "enum": [
          "https://yeetz.dev/bedrock/ontology/EpochRecord",
          "https://yeetz.dev/bedrock/ontology/DeployRecord",
          "https://yeetz.dev/bedrock/ontology/ReflectVerdict",
          "https://yeetz.dev/bedrock/ontology/Decision"
        ] },
        { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "contains": { "enum": [
            "https://yeetz.dev/bedrock/ontology/EpochRecord",
            "https://yeetz.dev/bedrock/ontology/DeployRecord",
            "https://yeetz.dev/bedrock/ontology/ReflectVerdict",
            "https://yeetz.dev/bedrock/ontology/Decision"
          ] } }
      ]
    }
  }
}
