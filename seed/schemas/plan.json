{
  "$comment": "Installed by bedrock v0.5.0 — DO NOT EDIT. This file is owned by the tool. Base changes: file an issue or PR at https://github.com/cleverunicornz/bedrock. Local refresh: bedrock update.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeetz.dev/bedrock/schema/plan/v3",
  "title": "Bedrock plan namespace vertex schema",
  "description": "Execution plans (0.2.0 base protocol): the seven execution-graph primitives — intent, acceptanceCriteria, consumes, tasks, witnesses, reflectDepth, disposition+residual. No custody choreography: no transitions, openings, or closures. Validates every situation/plan/*.yamlld vertex.",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@id", "@type", "intent", "acceptanceCriteria", "consumes", "tasks"],
  "properties": {
    "@context": { "const": "https://yeetz.dev/bedrock/context/v1" },
    "@id": { "$ref": "#/$defs/vertexId" },
    "@type": {
      "description": "Plan scalar, or an array containing Plan (repo archetypes ride alongside; rule C9)",
      "oneOf": [
        { "const": "https://yeetz.dev/bedrock/ontology/Plan" },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[^\\s]+$" }, "contains": { "const": "https://yeetz.dev/bedrock/ontology/Plan" } }
      ]
    },
    "label": { "$ref": "#/$defs/label" },
    "intent": { "$ref": "#/$defs/boundedText" },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/criterion" } },
    "consumes": { "$ref": "#/$defs/pointerList" },
    "tasks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/boundedText" } },
    "witnesses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/witness" }, "$comment": "CI-run-URL class; rule C8: disposition done with zero witnesses is a violation" },
    "reflectDepth": { "type": "integer", "minimum": 0, "$comment": "how deeply the follow-up reflection must read this plan" },
    "oracle": { "$ref": "#/$defs/pointer", "$comment": "optional standing comparator that judges intent against actual" },
    "disposition": {
      "type": "object",
      "properties": {
        "state": { "enum": ["draft", "active", "done", "abandoned"] },
        "residual": { "$ref": "#/$defs/boundedText" }
      },
      "required": ["state"],
      "additionalProperties": false,
      "$comment": "state done claims the promise held; without a witness it is a C8 violation"
    },
    "references": { "$ref": "#/$defs/vertexPointerList" },
    "requires": { "$ref": "#/$defs/vertexPointer" },
    "produces": { "$ref": "#/$defs/pathPointerList" },
    "member-of": { "$ref": "#/$defs/vertexPointer" },
    "source": { "$ref": "#/$defs/pathPointer" },
    "path": { "$ref": "#/$defs/pathPointerList" },
    "statement": { "$ref": "#/$defs/boundedText" },
    "body": { "$ref": "#/$defs/body" }
  },
  "minProperties": 3,
  "anyOf": [{ "required": ["label"] }, { "required": ["intent"] }],
  "$defs": {
    "vertexId": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/vertex/[a-z0-9][a-z0-9-]*$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "body": { "type": "string", "minLength": 1, "$comment": "0.5.0 face/body law: free-form depth prose — the vertex's own document, delivered by its `document` edge. NEVER compiled into the graph; everything above it (the face) is. No max length: depth is unbounded; the compiled face is what the soft budget measures." },
    "criterion": { "type": "string", "minLength": 1, "maxLength": 600 },
    "witness": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^https://[^\\s]+$", "$comment": "CI-run-URL class, never a local attestation" },
    "pathPointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/path/[A-Za-z0-9._/\\-]+$" },
    "vertexPointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/vertex/[a-z0-9][a-z0-9-]*$" },
    "vertexPointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/vertexPointer" } },
    "pointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/(vertex|path)/[A-Za-z0-9._/\\-]+$" },
    "pointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pointer" } },
    "pathPointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pathPointer" } }
  }
}
