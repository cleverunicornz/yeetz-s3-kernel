	bedrock:vertex\/structure-streams a bedrock:ontology\/SituationStructure ;
		bedrock:label "Append-only event logs (ADR 0002)" ;
		bedrock:path bedrock:path\/crates\/yeetz-s3-streams ;
		bedrock:statement "crates/yeetz-s3-streams — append-only event logs over the kernel.\n" .
	bedrock:vertex\/structure-tools a bedrock:ontology\/SituationStructure ;
		bedrock:label "Storage-boundary + dependency-floor CI gates" ;
		bedrock:path bedrock:path\/tools ;
		bedrock:statement "tools/ — storage-boundary and dependency-floor enforcement; the boundary is mechanically enforced here (adapter calls outside the sanctioned crates fail the build, with a ratchet allowlist).\n" .
}
graph:definition {
	bedrock:vertex\/term-promise-witness-oracle a bedrock:ontology\/Term ;
		bedrock:label "promise, oracle, witness, residual" ;
		bedrock:layer "floor" ;
		bedrock:statement "A promise states behavior; an oracle judges promise against actual. A witness is the retained observation of one run and proves existence, never exclusivity. Residual is what was deliberately not assured, declared so everyone sees the line of demarcation — we assure the positive space only; the negative space is infinite.\n" .
}
