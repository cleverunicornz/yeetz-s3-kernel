"@context": "urn:bedrock:context/v1"
"@id": "urn:bedrock:vertex/invariant-14-tailscale-first"
"@type": "urn:bedrock:ontology/Invariant"
label: "Tailscale-first"
layer: "floor"
statement: >
  Tailscale-first: all internal reach rides the tailnet; SSH-over-Tailscale for
  operators; nothing internal is served outside it; public-IP access is
  break-glass only.
